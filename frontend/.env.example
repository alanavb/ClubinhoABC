# Copie este arquivo para .env e preencha com as chaves públicas do projeto.
# Variáveis do Vite que chegam ao navegador precisam começar com VITE_.
# Nunca coloque SUPABASE_SECRET_KEY aqui.

VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[CHAVE-ANON-PUBLICA-DO-SUPABASE]
VITE_API_BASE_URL=http://localhost:5000/api
