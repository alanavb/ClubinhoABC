# Senha do banco: Supabase > Project Settings > Database > Database password.
# NUNCA coloque a senha real neste arquivo .example — copie para .env (ignorado pelo Git) e preencha lá.
DATABASE_URL=postgresql+psycopg2://postgres:SENHA@db.ukdkhjyvuyvovggbgeut.supabase.co:5432/postgres?sslmode=require
FLASK_ENV=development

# Usada para validar o token JWT emitido pelo Supabase Auth nas rotas protegidas
# (Supabase > Project Settings > API > JWT Keys).
SUPABASE_JWKS_URL=https://ukdkhjyvuyvovggbgeut.supabase.co/auth/v1/.well-known/jwks.json
