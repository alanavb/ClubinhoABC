# Copie este arquivo para .env e preencha os valores do seu ambiente.
# Nunca publique o arquivo .env nem a SUPABASE_SECRET_KEY.

# Banco PostgreSQL do Supabase
DATABASE_URL=[CONNECTION-STRING-DO-POSTGRES-SUPABASE]

SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_JWKS_URL=https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=[CHAVE-SECRETA-DO-SUPABASE]

# Servidor local
PORT=5000
FLASK_DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
